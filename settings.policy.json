{
  "statusLine": {
    "type": "command",
    "command": "\"$HOME\"/.claude/hooks/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/logged.sh derived-data-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/ledger hook pre-tool-use"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash|Read|Grep|Glob|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/logged.sh denied-read-retry.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/ledger hook pre-compact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/logged.sh deploy-drift.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/ledger hook session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/ledger hook prompt-submit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/logged.sh usage-pace.sh"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "allow": [
      "Bash(ledger notes:*)",
      "Bash(ledger go:*)",
      "Bash(ledger list:*)",
      "Bash(ledger show:*)",
      "Bash(ledger task new:*)",
      "Bash(ledger task go:*)",
      "Bash(ledger task claim:*)",
      "Bash(ledger task touch:*)",
      "Bash(ledger task release:*)",
      "Bash(ledger task park:*)",
      "Bash(ledger task unpark:*)",
      "Bash(ledger task block:*)",
      "Bash(ledger task unblock:*)",
      "Bash(ledger task pr:*)",
      "Bash(ledger task show:*)",
      "Bash(ledger task list:*)",
      "Bash(ledger task archive:*)",
      "Bash(ledger task gate:*)",
      "Bash(ledger tree show:*)",
      "Bash(ledger tree next:*)",
      "Bash(ledger tree ready:*)"
    ]
  }
}
